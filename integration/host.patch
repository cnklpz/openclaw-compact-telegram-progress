index 00000000..bc755f7b
--- /dev/null
+++ b/src/channels/turn-display-extensions.ts
@@ -0,0 +1,295 @@
+import type { PluginHookReplyUsageState } from "../plugins/hook-types.js";
+import type { PluginInstanceHandle } from "../plugins/plugin-instance-scope.js";
+import { isPluginRecordActive } from "../plugins/registry-lifecycle.js";
+import { resolveGlobalMap } from "../shared/global-singleton.js";
+import type { ChannelRuntimeContextRegistry } from "./plugins/channel-runtime-surface.types.js";
+
+export type TurnDisplayScope = Readonly<{
+  channel: "telegram";
+  accountId: string;
+  sessionKey: string;
+  sessionId: string;
+  runId: string;
+  conversationId: string;
+  threadId: string | null;
+}>;
+export type OrdinaryToolSummary = Readonly<{
+  callId: string;
+  toolName: string;
+  seq: number;
+  phase: "start" | "status" | "end";
+  status: "running" | "waiting" | "completed" | "failed" | "cancelled";
+}>;
+export type TurnDisplayEvent = Readonly<{
+  lease: object;
+  scope: TurnDisplayScope;
+  signal?: AbortSignal;
+  replay: false;
+  phase: "begin" | "finalize" | "progress" | "cancel" | "failed" | "settled";
+  status?: "completed";
+  usageScope?: "turn-aggregate";
+  usageState?: PluginHookReplyUsageState;
+  target?: "final-text";
+  pagination?: "before-chunking";
+  event?: OrdinaryToolSummary;
+}>;
+export type OrdinaryToolRow = Readonly<{ category: string; status: string; text: string }>;
+export type TurnDisplayCapabilityV1 = Readonly<{
+  version: 1;
+  register(params: {
+    pluginId: string;
+    signal: AbortSignal;
+    onLifecycle: (event: TurnDisplayEvent) => string | readonly OrdinaryToolRow[] | undefined;
+  }): { dispose(): void };
+}>;
+const approvedOwners = new Map([
+  ["finalUsageFooter.v1", "token-speed-footer"],
+  ["ordinaryToolProgress.v1", "compact-telegram-progress"],
+]);
+type Registration = {
+  instance: PluginInstanceHandle;
+  signal: AbortSignal;
+  invoke: (event: TurnDisplayEvent) => string | readonly OrdinaryToolRow[] | undefined;
+  dispose(): void;
+};
+const registrations = resolveGlobalMap<string, Set<Registration>>(
+  Symbol.for("openclaw.turnDisplayExtensions.v1"),
+  (entries) => {
+    for (const owners of entries.values()) {
+      for (const entry of owners) {
+        entry.dispose();
+      }
+    }
+    entries.clear();
+  },
+  "plugin-registry",
+);
+export function isTurnDisplayCapability(channelId: string, capability: string): boolean {
+  return channelId === "telegram" && approvedOwners.has(capability);
+}
+
+function isSafeDisplayText(value: unknown, maxLength: number): value is string {
+  if (typeof value !== "string" || value.trim().length === 0 || value.length > maxLength) {
+    return false;
+  }
+  for (const char of value) {
+    const code = char.codePointAt(0) ?? 0;
+    if (
+      (code <= 0x1f && code !== 0x09 && code !== 0x0a && code !== 0x0d) ||
+      code === 0x7f ||
+      (code >= 0x202a && code <= 0x202e) ||
+      (code >= 0x2066 && code <= 0x2069)
+    ) {
+      return false;
+    }
+  }
+  return true;
+}
+
+function validateOrdinaryRows(value: unknown): readonly OrdinaryToolRow[] | undefined {
+  if (!Array.isArray(value) || value.length > 3) {
+    return undefined;
+  }
+  const categories = new Set<string>();
+  const rows: OrdinaryToolRow[] = [];
+  for (const row of value) {
+    if (!row || typeof row !== "object") {
+      return undefined;
+    }
+    const candidate = row as Record<string, unknown>;
+    if (
+      !isSafeDisplayText(candidate.category, 64) ||
+      !isSafeDisplayText(candidate.status, 32) ||
+      !isSafeDisplayText(candidate.text, 200) ||
+      /[\r\n]/u.test(candidate.text) ||
+      !["Read", "Exec", "Search", "Write", "Fetch", "Browser", "Delegate", "Other"].includes(
+        candidate.category,
+      ) ||
+      !["running", "waiting", "completed", "failed", "cancelled"].includes(candidate.status) ||
+      categories.has(candidate.category)
+    ) {
+      return undefined;
+    }
+    categories.add(candidate.category);
+    rows.push({ category: candidate.category, status: candidate.status, text: candidate.text });
+  }
+  return rows;
+}
+/** Loader supplies the actual instance; pluginId in register is only a consistency check. */
+export function bindTurnDisplayContexts(
+  base: ChannelRuntimeContextRegistry,
+  instance: PluginInstanceHandle,
+): ChannelRuntimeContextRegistry {
+  return {
+    ...base,
+    // oxlint-disable-next-line typescript/no-unnecessary-type-parameters -- Caller-selected key typing, matching the base registry.
+    get: <T>(key: Parameters<ChannelRuntimeContextRegistry["get"]>[0]): T | undefined => {
+      if (!isTurnDisplayCapability(key.channelId, key.capability)) {
+        return base.get<T>(key);
+      }
+      const capability: TurnDisplayCapabilityV1 = {
+        version: 1,
+        register(params) {
+          if (
+            instance.pluginId !== approvedOwners.get(key.capability) ||
+            params.pluginId !== instance.pluginId ||
+            params.signal.aborted ||
+            instance.lifecycle.signal.aborted ||
+            !instance.acceptingCalls ||
+            instance.owner?.revoked
+          ) {
+            throw new Error("Turn display registration requires its approved live plugin instance");
+          }
+          const owners = registrations.get(key.capability) ?? new Set<Registration>();
+          if ([...owners].some((owner) => owner.instance === instance)) {
+            throw new Error("Turn display owner already registered for this plugin instance");
+          }
+          let disposed = false;
+          const dispose = () => {
+            if (disposed) {
+              return;
+            }
+            disposed = true;
+            params.signal.removeEventListener("abort", dispose);
+            instance.lifecycle.signal.removeEventListener("abort", dispose);
+            removeCleanup();
+            const currentOwners = registrations.get(key.capability);
+            if (currentOwners?.delete(registration) && currentOwners.size === 0) {
+              registrations.delete(key.capability);
+            }
+          };
+          const registration: Registration = {
+            instance,
+            signal: params.signal,
+            dispose,
+            invoke: (event) => {
+              if (
+                disposed ||
+                params.signal.aborted ||
+                instance.lifecycle.signal.aborted ||
+                !instance.acceptingCalls ||
+                instance.replacementPending ||
+                instance.owner?.revoked
+              ) {
+                return undefined;
+              }
+              try {
+                return instance.runConsumer(() => params.onLifecycle(event));
+              } catch {
+                return undefined;
+              }
+            },
+          };
+          const removeCleanup = instance.lifecycle.onDispose(dispose);
+          params.signal.addEventListener("abort", dispose, { once: true });
+          instance.lifecycle.signal.addEventListener("abort", dispose, { once: true });
+          owners.add(registration);
+          registrations.set(key.capability, owners);
+          return { dispose };
+        },
+      };
+      // Runtime contexts are typed by the caller-selected key, as in the base registry.
+      return capability as T;
+    },
+  };
+}
+
+/** Created only by the already-admitted channel turn. No transport or message handle escapes. */
+export function createTurnDisplayLease(scope: TurnDisplayScope, signal?: AbortSignal) {
+  const lease = Object.freeze({});
+  const base = { lease, scope: Object.freeze({ ...scope }), signal, replay: false as const };
+  // Snapshot only the currently published owner generation. Replacement plugin
+  // modules register while the old generation is draining; they are not visible
+  // until the registry marks their exact record active.
+  const owners = new Map<string, Registration>();
+  for (const [capability, candidates] of registrations) {
+    const active = [...candidates].filter((candidate) => {
+      const owner = candidate.instance.owner;
+      return owner !== undefined && isPluginRecordActive(owner.registry, owner.record);
+    });
+    if (active.length === 1) {
+      owners.set(capability, active[0]!);
+    }
+  }
+  let closed = false;
+  let finalized = false;
+  let progressFrozen = false;
+  const emit = (
+    capability: string,
+    event: TurnDisplayEvent,
+  ): string | readonly OrdinaryToolRow[] | undefined => {
+    const owner = owners.get(capability);
+    return owner && registrations.get(capability)?.has(owner) ? owner.invoke(event) : undefined;
+  };
+  for (const key of owners.keys()) {
+    emit(key, { ...base, phase: "begin" });
+  }
+  const close = (phase: "cancel" | "failed" | "settled" = "settled") => {
+    if (closed) {
+      return;
+    }
+    closed = true;
+    signal?.removeEventListener("abort", cancel);
+    for (const key of owners.keys()) {
+      emit(key, { ...base, phase });
+    }
+  };
+  const cancel = () => close("cancel");
+  signal?.addEventListener("abort", cancel, { once: true });
+  if (signal?.aborted) {
+    cancel();
+  }
+  return {
+    close,
+    isProgressActive() {
+      const owner = owners.get("ordinaryToolProgress.v1");
+      const instance = owner?.instance;
+      return (
+        !closed &&
+        !finalized &&
+        !progressFrozen &&
+        !signal?.aborted &&
+        owner !== undefined &&
+        registrations.get("ordinaryToolProgress.v1")?.has(owner) === true &&
+        !owner.signal.aborted &&
+        instance?.acceptingCalls === true &&
+        !instance.replacementPending &&
+        !instance.lifecycle.signal.aborted &&
+        instance.owner !== undefined &&
+        isPluginRecordActive(instance.owner.registry, instance.owner.record)
+      );
+    },
+    freezeProgress() {
+      progressFrozen = true;
+    },
+    finalize(usageState?: PluginHookReplyUsageState): string | undefined {
+      if (closed || finalized || signal?.aborted) {
+        return undefined;
+      }
+      finalized = true;
+      const value = emit("finalUsageFooter.v1", {
+        ...base,
+        phase: "finalize",
+        status: "completed",
+        usageScope: "turn-aggregate",
+        usageState,
+        target: "final-text",
+        pagination: "before-chunking",
+      });
+      // UTF-16 bounded before rendering. Telegram retains escaping, paging and transport custody.
+      return isSafeDisplayText(value, 1024) ? value : undefined;
+    },
+    progress(event: OrdinaryToolSummary): readonly OrdinaryToolRow[] | undefined {
+      if (closed || finalized || progressFrozen || signal?.aborted) {
+        return undefined;
+      }
+      const value = emit("ordinaryToolProgress.v1", { ...base, phase: "progress", event });
+      try {
+        return validateOrdinaryRows(value);
+      } catch {
+        return undefined;
+      }
+    },
+  };
+}
+export type TurnDisplayLease = ReturnType<typeof createTurnDisplayLease>;
