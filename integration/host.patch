@@ -0,0 +1,219 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { registerFooterPlugin } from "../../test/fixtures/turn-display-plugins/footer/registration.js";
+import { registerProgressPlugin } from "../../test/fixtures/turn-display-plugins/progress/registration.mjs";
+import { pluginFixture } from "../../test/fixtures/turn-display-plugins/registry.js";
+import type { PluginInstanceHandle } from "../plugins/plugin-instance-scope.js";
+import { createLivePreviewLifecycle } from "./message/live.js";
+import { createChannelProgressDraftCompositor } from "./progress-draft-compositor.js";
+import { createTurnDisplayLease, type TurnDisplayCapabilityV1 } from "./turn-display-extensions.js";
+
+const instances: PluginInstanceHandle[] = [];
+afterEach(async () => {
+  for (const instance of instances.splice(0)) await instance.dispose();
+});
+const scope = {
+  channel: "telegram" as const,
+  accountId: "a",
+  conversationId: "c",
+  threadId: null,
+  sessionKey: "key",
+  sessionId: "session",
+  runId: "run",
+};
+const stats = { usage: { input: 120, output: 30, total: 150 }, durationMs: 1000 };
+function load(id: string, mode = {}, activate = true) {
+  const fixture = pluginFixture(id, mode, activate);
+  instances.push(fixture.instance);
+  return fixture;
+}
+describe("host-owned instance-bound display capabilities", () => {
+  it("refuses pluginId self-assertion and raw registry overwrite", () => {
+    const fixture = load("attacker");
+    const capability = fixture.api.runtime.channel.runtimeContexts.get<TurnDisplayCapabilityV1>({
+      channelId: "telegram",
+      capability: "finalUsageFooter.v1",
+    })!;
+    expect(() =>
+      capability.register({
+        pluginId: "token-speed-footer",
+        signal: new AbortController().signal,
+        onLifecycle: () => "forged",
+      }),
+    ).toThrow("plugin instance");
+    expect(() =>
+      fixture.runtime.channel.runtimeContexts.register({
+        channelId: "telegram",
+        capability: "finalUsageFooter.v1",
+        context: { register: () => {} },
+      }),
+    ).toThrow("host-owned");
+  });
+  it("stages a replacement registration before commit and selects the published generation", async () => {
+    const old = load("token-speed-footer", { deliveryMode: "preview-safe" });
+    registerFooterPlugin(old.api);
+    const oldLease = createTurnDisplayLease({ ...scope, runId: "old" });
+    const candidate = load(
+      "token-speed-footer",
+      { deliveryMode: "preview-safe", footerPrefix: "NEXT" },
+      false,
+    );
+    expect(() => registerFooterPlugin(candidate.api)).not.toThrow();
+    expect(oldLease.finalize(stats)).toContain("总计 150");
+    const beforeCommit = createTurnDisplayLease({ ...scope, runId: "precommit" });
+    expect(beforeCommit.finalize(stats)).toContain("🧮 用量");
+    beforeCommit.close();
+    const { quiescePluginRegistry, markPluginRegistryActive } =
+      await import("../plugins/registry-lifecycle.js");
+    quiescePluginRegistry(old.builder.registry);
+    markPluginRegistryActive(candidate.builder.registry);
+    const newLease = createTurnDisplayLease({ ...scope, runId: "new" });
+    expect(newLease.finalize(stats)).toContain("NEXT 用量");
+    oldLease.close();
+    newLease.close();
+  });
+  it("isolates account/topic/session/run leases and fences duplicates, cancellation, abort and reload", async () => {
+    const fixture = load("token-speed-footer", { deliveryMode: "preview-safe" });
+    registerFooterPlugin(fixture.api);
+    const one = createTurnDisplayLease(scope);
+    const two = createTurnDisplayLease({
+      ...scope,
+      accountId: "other",
+      threadId: "42",
+      sessionId: "other",
+      runId: "other",
+    });
+    expect(one.finalize(stats)).toContain("总计 150");
+    expect(one.finalize(stats)).toBeUndefined();
+    expect(two.finalize({ usage: { output: 70 } })).toContain("输出 70");
+    const controller = new AbortController();
+    const aborted = createTurnDisplayLease(scope, controller.signal);
+    controller.abort();
+    expect(aborted.finalize(stats)).toBeUndefined();
+    const retained = createTurnDisplayLease(scope);
+    await fixture.instance.drain();
+    expect(retained.finalize(stats)).toBeUndefined();
+    const replacement = load("token-speed-footer", { deliveryMode: "preview-safe" });
+    registerFooterPlugin(replacement.api);
+    expect(retained.finalize(stats)).toBeUndefined();
+    const fresh = createTurnDisplayLease({ ...scope, runId: "fresh" });
+    expect(fresh.finalize(stats)).toContain("总计 150");
+    one.close();
+    two.close();
+    retained.close();
+    fresh.close();
+  });
+  it("fails closed on malformed plugin display output", () => {
+    const footer = load("token-speed-footer");
+    const footerCapability =
+      footer.api.runtime.channel.runtimeContexts.get<TurnDisplayCapabilityV1>({
+        channelId: "telegram",
+        capability: "finalUsageFooter.v1",
+      });
+    footerCapability!.register({
+      pluginId: "token-speed-footer",
+      signal: footer.instance.lifecycle.signal,
+      onLifecycle: () => "\u0001".repeat(1025),
+    });
+    expect(createTurnDisplayLease(scope).finalize(stats)).toBeUndefined();
+    const progress = load("compact-telegram-progress");
+    const progressCapability =
+      progress.api.runtime.channel.runtimeContexts.get<TurnDisplayCapabilityV1>({
+        channelId: "telegram",
+        capability: "ordinaryToolProgress.v1",
+      });
+    progressCapability!.register({
+      pluginId: "compact-telegram-progress",
+      signal: progress.instance.lifecycle.signal,
+      onLifecycle: () => [
+        { category: "Read", status: "running", text: "ok" },
+        { category: "Read", status: "completed", text: "duplicate" },
+      ],
+    });
+    expect(
+      createTurnDisplayLease(scope).progress({
+        callId: "c",
+        toolName: "read",
+        phase: "start",
+        status: "running",
+        seq: 1,
+      }),
+    ).toBeUndefined();
+  });
+
+  it("keeps three category rows, superseded calls, native plan/headline and attention lanes", async () => {
+    const fixture = load("compact-telegram-progress");
+    registerProgressPlugin(fixture.api);
+    const lease = createTurnDisplayLease(scope);
+    const snapshots: unknown[] = [];
+    const compositor = createChannelProgressDraftCompositor({
+      active: true,
+      mode: "progress",
+      seed: "fixture",
+      entry: { streaming: { mode: "progress", progress: { toolProgress: true, maxLines: 12 } } },
+      update: (_text, options) => {
+        snapshots.push(options.snapshot);
+      },
+      preparedItems: true,
+    });
+    let seq = 0;
+    const update = async (
+      callId: string,
+      toolName: string,
+      phase: "start" | "end",
+      status: "running" | "completed" = "running",
+    ) => {
+      const rows = lease.progress({ callId, toolName, phase, status, seq: ++seq });
+      if (rows) await compositor.replaceOrdinaryToolLines(rows);
+    };
+    await compositor.pushPlanProgress([{ step: "Keep plan", status: "in_progress" }]);
+    await compositor.pushPreambleHeadline("Keep headline", { itemId: "headline" });
+    await compositor.pushApprovalEvent({
+      approvalId: "approval-1",
+      phase: "requested",
+      title: "Keep approval",
+    });
+    await update("old", "read", "start");
+    await update("new", "read", "start");
+    await update("exec", "exec", "start");
+    await update("search", "web_search", "start");
+    await update("write", "write", "start");
+    const before = compositor.getSnapshot();
+    await update("old", "read", "end", "completed");
+    expect(compositor.getSnapshot().lines).toEqual(before.lines);
+    await update("new", "read", "end", "completed");
+    const snapshot = compositor.getSnapshot();
+    const categories = snapshot.lines.filter(
+      (line) => typeof line !== "string" && line.id?.startsWith("compact-tool:"),
+    );
+    expect(categories).toHaveLength(3);
+    expect(categories.map((line) => typeof line !== "string" && line.id)).toEqual([
+      "compact-tool:Search",
+      "compact-tool:Write",
+      "compact-tool:Read",
+    ]);
+    expect(
+      snapshot.lines.some((line) => typeof line !== "string" && line.kind === "approval"),
+    ).toBe(true);
+    expect(snapshot.plan?.[0].step).toBe("Keep plan");
+    expect(snapshot.statusHeadline).toBe("Keep headline");
+    const nativeLifecycle = createLivePreviewLifecycle({
+      onFinalStarted: () => compositor.markFinalReplyStarted(),
+    });
+    nativeLifecycle.beginFinalDelivery();
+    const frozen = compositor.getSnapshot();
+    await update("late", "exec", "start");
+    expect(compositor.getSnapshot()).toEqual(frozen);
+    lease.close("failed");
+    expect(
+      lease.progress({
+        callId: "late2",
+        toolName: "read",
+        phase: "start",
+        status: "running",
+        seq: ++seq,
+      }),
+    ).toBeUndefined();
+    compositor.cancel();
+    expect(snapshots.length).toBeGreaterThan(0);
+  });
+});
diff --git a/src/channels/turn-display-extensions.ts b/src/channels/turn-display-extensions.ts
