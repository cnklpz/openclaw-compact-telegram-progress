+import { registerFooterPlugin } from "../../../test/fixtures/turn-display-plugins/footer/registration.js";
+import { registerProgressPlugin } from "../../../test/fixtures/turn-display-plugins/progress/registration.mjs";
+import { pluginFixture } from "../../../test/fixtures/turn-display-plugins/registry.js";
