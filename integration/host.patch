+import { createPluginRecord } from "../../../src/plugins/loader-records.js";
+import { getPluginInstance } from "../../../src/plugins/plugin-instance-scope.js";
+import { markPluginRegistryActive } from "../../../src/plugins/registry-lifecycle.js";
+import { createRuntimeTestRegistry } from "../../../src/plugins/registry-runtime.test-helpers.js";
+import { createChannelRuntimeContextRegistry } from "../../../src/plugins/runtime/channel-runtime-contexts.js";
+import type { PluginRuntime } from "../../../src/plugins/runtime/types.js";
+
+export function pluginFixture(id: string, pluginConfig = {}, activate = true) {
+  // Only channel contexts are consumed; no config, provider, token or transport is loaded.
+  const runtime = {
+    channel: { runtimeContexts: createChannelRuntimeContextRegistry() },
+  } as PluginRuntime;
+  const builder = createRuntimeTestRegistry(runtime);
+  const record = createPluginRecord({
+    id,
+    source: `/synthetic/${id}/index.js`,
+    origin: "global",
+    enabled: true,
+    configSchema: false,
+  });
+  const api = builder.createApi(record, { config: {}, pluginConfig });
+  if (activate) markPluginRegistryActive(builder.registry);
+  const instance = getPluginInstance(record)!;
+  return { api, instance, builder, runtime };
+}
