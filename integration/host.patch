+} from "./bot-message-dispatch.test-harness.js";
+import type * as DeliveryModule from "./bot/delivery.replies.js";
+import type * as DraftModule from "./draft-stream.js";
+import type { TelegramDraftStream } from "./draft-stream.js";
+import type * as EditModule from "./send-edit.js";
+import { planTelegramTextDeliveryPages } from "./telegram-text-delivery.js";
+
+const instances: PluginInstanceHandle[] = [];
+afterEach(async () => {
+  for (const instance of instances.splice(0)) await instance.dispose();
+});
+function registerPlugins() {
+  const footer = pluginFixture("token-speed-footer", { deliveryMode: "preview-safe" });
+  const progress = pluginFixture("compact-telegram-progress");
+  instances.push(footer.instance, progress.instance);
+  registerFooterPlugin(footer.api);
+  registerProgressPlugin(progress.api);
+  expect(footer.builder.registry.typedHooks).toHaveLength(0);
+  expect(progress.builder.registry.typedHooks).toHaveLength(0);
+  return { footer, progress };
+}
+
+// Real official aggregate accounting and result completion, with provider output
+// injected as a settled execution fixture. Storage is absent, not a real session.
+async function finishNative(
+  opts: Parameters<typeof completeReplyAgentRun>[0]["context"]["opts"],
+  usage: { input: number; output: number; total: number } | undefined,
+  text: string,
+  durationMs = 2500,
+) {
+  const now = 10000;
+  const clock = vi.spyOn(Date, "now").mockReturnValue(now);
+  try {
+    const context = {
+      cfg: { messages: { responseUsage: "full" } },
+      defaultModel: "fixture",
+      followupRun: {
+        run: {
+          agentId: "fixture",
+          agentDir: "/synthetic/no-auth",
+          sessionId: "session-1",
+          provider: "fixture",
+          model: "fixture",
+          verboseLevel: "off",
+        },
+      },
+      opts,
+      runId: "run-1",
+      runStartedAt: now - durationMs,
+      pendingToolTasks: new Set(),
+      sessionCtx: {},
+      resolvedVerboseLevel: "off",
+      execution: {
+        result: {
+          payloads: [{ text }],
+          meta: {
+            agentMeta: {
+              usage,
+              lastCallUsage: { input: 1, output: 2, total: 3 },
+              contextTokens: 1000,
+            },
+          },
+        },
+        resolved: { provider: "fixture", model: "fixture" },
+        fallback: { exhausted: false, attempts: [] },
+        status: "ok",
+      },
+      activeIsNewSession: false,
+      isHeartbeat: false,
+      returnWithQueuedFollowupDrain: (value: unknown) => value,
+    } as unknown as Parameters<typeof completeReplyAgentRun>[0]["context"];
+    const accounting = await accountAgentTurn(context);
+    expect(accounting.replyUsageState.usage).toEqual(
+      usage && {
+        ...usage,
+        cacheRead: undefined,
+        cacheWrite: undefined,
+      },
+    );
+    expect(accounting.replyUsageState.durationMs).toBe(durationMs);
+    const responseUsageLine = resolveResponseUsageLine({
+      config: context.cfg,
+      agentDir: "/synthetic/no-auth",
+      channel: "telegram",
+      usage,
+      replyUsageState: accounting.replyUsageState,
+    });
+    return await completeReplyAgentRun({
+      context,
+      accounting,
+      prepared: {
+        kind: "continue",
+        guardedReplyPayloads: [{ text }],
+        responseUsageLine,
+        completedSourceReplyDelivery: false,
+      } as Parameters<typeof completeReplyAgentRun>[0]["prepared"],
+    });
+  } finally {
+    clock.mockRestore();
+  }
+}
+
